<Window x:Class="WikarIsland.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WikarIsland.Controls"
        Title="Wikar Island"
        Width="530" Height="600"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Background="#FF0B0B0E"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#17171D"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="RoundIcon" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Большая белая круглая кнопка паузы -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#0B0B0E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="#F5F5F7"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#D8D8DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Большая плитка центра управления -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#1E1E25"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Width" Value="152"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Background="{TemplateBinding Background}" Padding="14,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитки быстрых действий на «Главной» -->
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#17171D"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="14" Background="{TemplateBinding Background}" Padding="14,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#222229"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionIcon" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ActionSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#A0A0AA"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Вкладка-значок: подпись видна только у выбранной -->
        <Style x:Key="IconTab" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
            <Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="17" Padding="9,7" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Мини-капсула: в неё «свернулась» пилюля. Клик — свернуть остров обратно -->
        <Border x:Name="Capsule" HorizontalAlignment="Center" Margin="0,8,0,4" Padding="14,5"
                CornerRadius="14" Background="#16161C" Cursor="Hand" ToolTip="Свернуть остров"
                MouseLeftButtonDown="Capsule_Down" MouseLeftButtonUp="Capsule_Click">
            <StackPanel Orientation="Horizontal">
                <controls:EyesControl x:Name="CapsuleEyes" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="CapsuleTime" Text="00:00" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- Вкладки -->
        <DockPanel Grid.Row="1" Margin="8,2,8,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReloadButton" Style="{StaticResource RoundIcon}" Width="30" Margin="1,0" FontSize="13"
                        Content="&#xE72C;" ToolTip="Обновить страницу" Click="Reload_Click"/>
                <Button x:Name="PopOutButton" Style="{StaticResource RoundIcon}" Width="30" Margin="1,0" FontSize="13"
                        Content="&#xE8A7;" ToolTip="Открыть в отдельном окне" Click="PopOut_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabHome" Tag="home" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Главная">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Главная" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabCenter" Tag="control" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Центр управления">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Центр" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabSystem" Tag="system" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Показатели ПК">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Система" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabWeather" Tag="weather" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Погода">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Погода" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabClipboard" Tag="clipboard" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Буфер обмена">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Буфер" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabChatGpt" Tag="chatgpt" Content="GPT" ToolTip="ChatGPT" Style="{StaticResource IconTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabClaude" Tag="claude" Content="Claude" Style="{StaticResource IconTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabGemini" Tag="gemini" Content="Gemini" Style="{StaticResource IconTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabDeepSeek" Tag="deepseek" Content="DS" ToolTip="DeepSeek" Style="{StaticResource IconTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabDeepL" Tag="deepl" Content="DeepL" ToolTip="Переводчик DeepL" Style="{StaticResource IconTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabSettings" Tag="settings" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Настройки">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Настройки" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">

            <!-- ===== Главная ===== -->
            <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,12">

                    <!-- Погода и дата -->
                    <Border Style="{StaticResource Card}" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="HomeWeather_Click">
                        <DockPanel>
                            <TextBlock x:Name="HomeDate" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" FontSize="13" FontFamily="{StaticResource UiFont}"/>
                            <controls:WeatherIcon x:Name="HomeWeatherIcon" Width="30" Height="30" Margin="0,0,10,0"/>
                            <TextBlock x:Name="HomeWeather" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextMain}" FontSize="14" FontFamily="{StaticResource UiFont}"/>
                        </DockPanel>
                    </Border>

                    <!-- Плеер и звук слева, быстрые действия справа -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <!-- Плеер -->
                            <Border x:Name="PlayerCard" Style="{StaticResource Card}" Padding="14">
                                <Grid>
                                    <TextBlock x:Name="PlayerEmpty" Style="{StaticResource Hint}" FontSize="13.5"
                                               Text="Сейчас ничего не играет"/>
                                    <Grid x:Name="PlayerContent" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="CardCover" Width="104" Height="104" Stretch="UniformToFill" VerticalAlignment="Top">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,104,104" RadiusX="12" RadiusY="12"/>
                                            </Image.Clip>
                                        </Image>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Image x:Name="CardAppIcon" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CardSource" Foreground="{StaticResource TextDim}" FontSize="11"
                                                           FontWeight="SemiBold" FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CardTitle" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextMain}" FontSize="17" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource UiFont}"/>
                                            <TextBlock x:Name="CardArtist" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextDim}" FontSize="13.5"
                                                       FontFamily="{StaticResource UiFont}"/>
                                            <Grid x:Name="ProgressArea" Height="12" Margin="0,12,0,0" Background="Transparent"
                                                  Cursor="Hand" MouseLeftButtonDown="Progress_Click">
                                                <Border Height="4" CornerRadius="2" Background="#33FFFFFF"/>
                                                <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Background="#F2F2F5"
                                                        HorizontalAlignment="Left" Width="0"/>
                                            </Grid>
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock x:Name="RemainText" DockPanel.Dock="Right" Style="{StaticResource Hint}" FontSize="11"/>
                                                <TextBlock x:Name="PosText" Style="{StaticResource Hint}" FontSize="11"/>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                <Button Style="{StaticResource RoundIcon}" Content="&#xE892;" ToolTip="Предыдущий" Click="Prev_Click"/>
                                                <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Content="&#xE768;" Click="PlayPause_Click"/>
                                                <Button Style="{StaticResource RoundIcon}" Content="&#xE893;" ToolTip="Следующий" Click="Next_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Звук -->
                            <Border Style="{StaticResource Card}" Padding="10,8">
                                <Grid>
                                    <DockPanel>
                                        <Button x:Name="MuteButton" DockPanel.Dock="Left" Style="{StaticResource RoundIcon}" Margin="0"
                                                Width="34" Height="32" FontSize="14" Content="&#xE767;" ToolTip="Без звука" Click="Mute_Click"/>
                                        <Button x:Name="DeviceButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                                Padding="10,6" MaxWidth="170" ToolTip="Куда идёт звук" Click="DeviceButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DeviceButtonText" Margin="7,0" MaxWidth="100" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="VolumePercent" DockPanel.Dock="Right" Width="38" TextAlignment="Right" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextMain}" FontSize="14"
                                                   FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Margin="8,0,0,0"
                                                VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                ValueChanged="VolumeSlider_ValueChanged"/>
                                    </DockPanel>
                                    <Popup x:Name="DevicePopup" PlacementTarget="{Binding ElementName=DeviceButton}" Placement="Bottom"
                                           HorizontalOffset="-140" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="#24242C" CornerRadius="10" Padding="6" BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <StackPanel x:Name="DevicesPanel" MinWidth="290"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <!-- Быстрые действия -->
                        <UniformGrid Grid.Column="1" Columns="2" Margin="10,0,0,0" VerticalAlignment="Top">
                            <Button x:Name="TimerTileButton" Style="{StaticResource ActionTile}" Click="TimerTile_Click">
                                <DockPanel>
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource ActionIcon}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Таймер выключения" Style="{StaticResource ActionText}"/>
                                        <TextBlock x:Name="TimerTileState" Style="{StaticResource ActionSub}" Visibility="Collapsed"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="FocusTile_Click">
                                <DockPanel>
                                    <TextBlock Text="&#xE916;" Style="{StaticResource ActionIcon}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Таймер и напоминания" Style="{StaticResource ActionText}"/>
                                        <TextBlock x:Name="FocusTileState" Style="{StaticResource ActionSub}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="NotesTile_Click">
                                <DockPanel>
                                    <TextBlock Text="&#xE70B;" Style="{StaticResource ActionIcon}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Заметки" Style="{StaticResource ActionText}"/>
                                        <TextBlock x:Name="NotesTileState" Style="{StaticResource ActionSub}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="RecordTile_Click" ToolTip="Запись экрана, на котором стоит пилюля, в MP4 (без звука). Остановить — клик по пилюле">
                                <DockPanel>
                                    <TextBlock x:Name="RecordTileIcon" Text="&#xE714;" Style="{StaticResource ActionIcon}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="RecordTileText" Text="Запись экрана" Style="{StaticResource ActionText}"/>
                                        <TextBlock x:Name="RecordTileState" Text="идёт запись" Style="{StaticResource ActionSub}" Foreground="#FF8A80" Visibility="Collapsed"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button x:Name="AudioTile" Style="{StaticResource ActionTile}" Click="AudioTile_Click"
                                    ToolTip="Запись звука из колонок, с микрофона или обоих сразу (.m4a)">
                                <DockPanel>
                                    <TextBlock x:Name="AudioTileIcon" Text="&#xE720;" Style="{StaticResource ActionIcon}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="AudioTileText" Text="Запись звука" Style="{StaticResource ActionText}"/>
                                        <TextBlock x:Name="AudioTileState" Style="{StaticResource ActionSub}" Foreground="#FF8A80" Visibility="Collapsed"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="AreaTile_Click" ToolTip="Скриншот выделенной области (Win+Shift+S)">
                                <DockPanel>
                                    <TextBlock Text="&#xE8B3;" Style="{StaticResource ActionIcon}"/>
                                    <TextBlock Text="Область" Style="{StaticResource ActionText}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="FullTile_Click" ToolTip="Снимок всего экрана: в папку «Изображения\Screenshots» и в буфер">
                                <DockPanel>
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource ActionIcon}"/>
                                    <TextBlock Text="Весь экран" Style="{StaticResource ActionText}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>

                    <!-- Ярлыки -->
                    <Border x:Name="LauncherCard" Style="{StaticResource Card}" Padding="12,10" AllowDrop="True"
                            Drop="Launcher_Drop" DragOver="Launcher_DragOver">
                        <StackPanel>
                            <DockPanel Margin="2,0,0,8">
                                <Button x:Name="DesktopIconsButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                        Padding="9,4" FontSize="12" Click="DesktopIcons_Click"/>
                                <TextBlock Text="Ярлыки" VerticalAlignment="Center" Foreground="{StaticResource TextMain}"
                                           FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            </DockPanel>
                            <WrapPanel x:Name="LauncherPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- Steam -->
                    <Border x:Name="SteamCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image x:Name="SteamCardIcon" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Steam" Foreground="{StaticResource TextMain}" FontSize="14"
                                           FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                            <StackPanel x:Name="SteamList"/>
                        </StackPanel>
                    </Border>

                    <!-- Уведомления -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="ClearNotificationsButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                        Content="Очистить всё" Padding="10,4" FontSize="12" Click="ClearNotifications_Click"/>
                                <TextBlock Text="Уведомления" VerticalAlignment="Center" Foreground="{StaticResource TextMain}" FontSize="14"
                                           FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            </DockPanel>
                            <StackPanel x:Name="NotificationsList"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="HomeHint" Style="{StaticResource Hint}" LineHeight="18" Margin="4,2,4,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Таймер выключения (из плитки) ===== -->
            <ScrollViewer x:Name="TimerView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,12">
                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Click="Back_Click"
                            Background="Transparent" Content="&#x2190;  Назад"/>
                    <!-- Таймер выключения -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Таймер выключения" Foreground="{StaticResource TextMain}" FontSize="14"
                                       FontWeight="SemiBold" FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <RadioButton x:Name="ActShutdown" Content="Выключить" GroupName="PowerAction" IsChecked="True" Style="{StaticResource SettingsRadio}" FontSize="13"/>
                                <RadioButton x:Name="ActRestart" Content="Перезагрузить" GroupName="PowerAction" Style="{StaticResource SettingsRadio}" FontSize="13"/>
                                <RadioButton x:Name="ActSleep" Content="Сон" GroupName="PowerAction" Style="{StaticResource SettingsRadio}" FontSize="13"/>
                                <RadioButton x:Name="ActHibernate" Content="Гибернация" GroupName="PowerAction" Style="{StaticResource SettingsRadio}" FontSize="13"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="15 мин" Tag="15" Click="TimerPreset_Click"/>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="30 мин" Tag="30" Click="TimerPreset_Click"/>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="1 ч" Tag="60" Click="TimerPreset_Click"/>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="2 ч" Tag="120" Click="TimerPreset_Click"/>
