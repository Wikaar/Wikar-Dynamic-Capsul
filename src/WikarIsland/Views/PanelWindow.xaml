                        </Border>
                        <TextBlock Text="ИИ-ЧАТЫ" Style="{StaticResource SetGroup}" Margin="4,14,0,6"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                        <TextBlock Style="{StaticResource SetHint}" Margin="0,4,0,2" Text="ChatGPT, Claude, Gemini, DeepSeek и DeepL открываются как сайты. Вход в аккаунты сохраняется."/>
                            </StackPanel>
                        </Border>

                        </StackPanel>
                        <StackPanel x:Name="SetSec_weather" Tag="weather" Visibility="Collapsed">
                        <TextBlock Text="Погода" Style="{StaticResource SetTitle}"/>
                        <TextBlock Text="Город для прогноза в капсуле" Style="{StaticResource SetSubtitle}"/>
                        <TextBlock Text="ГОРОД" Style="{StaticResource SetGroup}" Margin="4,14,0,6"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                        <TextBlock x:Name="WeatherCityText" Style="{StaticResource Hint}" FontSize="13.5" Foreground="{StaticResource TextMain}" Margin="0,4,0,8"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SetButton}" Margin="6,0,0,0" Content="Найти город" Click="CitySearch_Click"/>
                            <TextBox x:Name="CitySearchBox" Style="{StaticResource SetBox}" KeyDown="CitySearchBox_KeyDown"/>
                        </DockPanel>
                        <StackPanel x:Name="CityResults" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource SetHint}" Margin="0,4,0,2" Text="Прогноз — MET Norway (api.met.no)."/>
                            </StackPanel>
                        </Border>

                        </StackPanel>
                        <StackPanel x:Name="SetSec_notify" Tag="notify" Visibility="Collapsed">
                        <TextBlock Text="Уведомления" Style="{StaticResource SetTitle}"/>
                        <TextBlock Text="Уведомления программ и режим «Не беспокоить»" Style="{StaticResource SetSubtitle}"/>
                        <TextBlock Text="НА ОСТРОВЕ" Style="{StaticResource SetGroup}" Margin="4,14,0,6"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                        <CheckBox x:Name="NotificationsBox" Content="Показывать уведомления программ" Style="{StaticResource SetCheck}" Click="Setting_Changed"/>
                        <TextBlock Style="{StaticResource SetHint}" Margin="0,2,0,6" Text="Сними галочку у программы, чтобы её уведомления не показывались."/>
                        <StackPanel x:Name="NotificationApps"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
                            <TextBlock Text="НЕ БЕСПОКОИТЬ" Style="{StaticResource SetGroup}"/>
                            <ToggleButton x:Name="Help8" Style="{StaticResource HelpToggle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SetHint}" Margin="4,0,4,6" Text="Уведомления не всплывают в капсуле, но остаются в истории. Когда режим выключится, остров покажет, сколько их пришло. Быстро включить — в меню значка в трее."
                                   Visibility="{Binding IsChecked, ElementName=Help8, Converter={StaticResource BoolToVis}}"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                        <CheckBox x:Name="DndManualBox" Content="Включить сейчас" Style="{StaticResource SetCheck}" Click="Dnd_Changed"/>
                        <CheckBox x:Name="DndFullscreenBox" Content="Автоматически, пока открыта игра или видео на весь экран" Style="{StaticResource SetCheck}" Click="Dnd_Changed"/>
                        <CheckBox x:Name="DndHidePillBox" Content="…и прятать саму капсулу" Style="{StaticResource SetCheck}" Click="Dnd_Changed" Margin="16,5,0,5"/>
                        <WrapPanel Margin="0,4,0,2">
                            <CheckBox x:Name="DndScheduleBox" Content="По расписанию с" Style="{StaticResource SettingsCheck}" FontSize="12.5" Margin="0,0,0,0" Click="Dnd_Changed" VerticalAlignment="Center"/>
                            <TextBox x:Name="DndFromBox" Width="60" Style="{StaticResource SetBox}" Padding="6,3" Margin="8,0,6,0" VerticalAlignment="Center" LostFocus="DndTime_LostFocus"/>
                            <TextBlock Text="до" Style="{StaticResource SetHint}" VerticalAlignment="Center"/>
                            <TextBox x:Name="DndToBox" Width="60" Style="{StaticResource SetBox}" Padding="6,3" Margin="6,0,0,0" VerticalAlignment="Center" LostFocus="DndTime_LostFocus"/>
                        </WrapPanel>
                            </StackPanel>
                        </Border>

                        </StackPanel>
                        <StackPanel x:Name="SetSec_games" Tag="games" Visibility="Collapsed">
                        <TextBlock Text="Игры и загрузки" Style="{StaticResource SetTitle}"/>
                        <TextBlock Text="FPS в капсуле и ход загрузок" Style="{StaticResource SetSubtitle}"/>
                        <TextBlock Text="ИГРЫ" Style="{StaticResource SetGroup}" Margin="4,14,0,6"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                        <CheckBox x:Name="GameHudBox" Style="{StaticResource SetCheck}" Click="Setting_Changed">
                            <StackPanel>
                                <TextBlock Text="FPS и нагрузка в капсуле" TextWrapping="Wrap"/>
                                <TextBlock Text="Пока идёт игра на весь экран" FontSize="11" Foreground="#8C8C97" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock x:Name="GameHudStatus" Style="{StaticResource SetHint}" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ЗАГРУЗКИ" Style="{StaticResource SetGroup}" Margin="4,14,0,6"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                        <CheckBox x:Name="DownloadsBox" Style="{StaticResource SetCheck}" Click="Setting_Changed">
                            <StackPanel>
                                <TextBlock Text="Загрузки в капсуле" TextWrapping="Wrap"/>
                                <TextBlock Text="Браузеры, Steam, Epic, Battle.net, EA, Ubisoft, GOG, торренты" FontSize="11" Foreground="#8C8C97" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="DownloadCardBox" Content="Карточка, когда файл из браузера докачался" Style="{StaticResource SetCheck}" Click="Setting_Changed"/>
                            </StackPanel>
                        </Border>

                        </StackPanel>
                        <StackPanel x:Name="SetSec_focus" Tag="focus" Visibility="Collapsed">
                        <TextBlock Text="Фокус и Pomodoro" Style="{StaticResource SetTitle}"/>
                        <TextBlock Text="Длительность работы и перерывов" Style="{StaticResource SetSubtitle}"/>
                        <TextBlock Text="POMODORO, МИНУТ" Style="{StaticResource SetGroup}" Margin="4,14,0,6"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Работа" Style="{StaticResource Hint}" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <TextBox x:Name="PomodoroWorkBox" Grid.Column="1" Width="56" Style="{StaticResource SetBox}" Padding="6,3" Margin="0,3" LostFocus="Pomodoro_LostFocus"/>
                            <TextBlock Grid.Row="1" Text="Перерыв" Style="{StaticResource Hint}" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <TextBox x:Name="PomodoroBreakBox" Grid.Row="1" Grid.Column="1" Width="56" Style="{StaticResource SetBox}" Padding="6,3" Margin="0,3" LostFocus="Pomodoro_LostFocus"/>
                            <TextBlock Grid.Row="2" Text="Длинный перерыв" Style="{StaticResource Hint}" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <TextBox x:Name="PomodoroLongBox" Grid.Row="2" Grid.Column="1" Width="56" Style="{StaticResource SetBox}" Padding="6,3" Margin="0,3" LostFocus="Pomodoro_LostFocus"/>
                        </Grid>
                            </StackPanel>
                        </Border>

                        </StackPanel>
                        <StackPanel x:Name="SetSec_data" Tag="data" Visibility="Collapsed">
                        <TextBlock Text="Данные и журнал" Style="{StaticResource SetTitle}"/>
                        <TextBlock Text="Резервная копия и журнал ошибок" Style="{StaticResource SetSubtitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
                            <TextBlock Text="РЕЗЕРВНАЯ КОПИЯ" Style="{StaticResource SetGroup}"/>
                            <ToggleButton x:Name="Help9" Style="{StaticResource HelpToggle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SetHint}" Margin="4,0,4,6" Text="Все настройки, заметки, ярлыки и VPN-серверы в одном файле — для переустановки Windows или чтобы перенести остров на другой компьютер."
                                   Visibility="{Binding IsChecked, ElementName=Help9, Converter={StaticResource BoolToVis}}"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource SetButton}" Content="Сохранить копию…" Click="BackupExport_Click"/>
                            <Button Style="{StaticResource SetButton}" Content="Восстановить из копии…" Click="BackupImport_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="BackupStatusText" Style="{StaticResource SetHint}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ЖУРНАЛ ОШИБОК" Style="{StaticResource SetGroup}" Margin="4,14,0,6"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                        <TextBlock x:Name="LogStatusText" Style="{StaticResource SetHint}" Margin="0,4,0,2" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource SetButton}" Content="Скопировать" Click="LogCopy_Click"/>
                            <Button Style="{StaticResource SetButton}" Content="Открыть" Click="LogOpen_Click"/>
                            <Button Style="{StaticResource SetButton}" Content="Очистить" Click="LogClear_Click"/>
                        </WrapPanel>
                            </StackPanel>
                        </Border>

                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
