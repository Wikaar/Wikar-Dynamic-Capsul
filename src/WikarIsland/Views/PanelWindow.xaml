<Window x:Class="WikarIsland.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wikar Island"
        Width="900" Height="560"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Background="#FF141417"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1C1C22"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="RoundIcon" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя строка: вкладки и кнопки -->
            <DockPanel Margin="10,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReloadButton" Style="{StaticResource FlatButton}" Content="⟳"
                            ToolTip="Обновить страницу" Click="Reload_Click"/>
                    <Button x:Name="PopOutButton" Style="{StaticResource FlatButton}" Content="↗"
                            ToolTip="Открыть этот чат в отдельном окне" Click="PopOut_Click"/>
                    <Button Style="{StaticResource FlatButton}" Content="✕" ToolTip="Свернуть" Click="Close_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabHome" Tag="home" Content="Главная" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabWeather" Tag="weather" Content="Погода" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabClipboard" Tag="clipboard" Content="Буфер" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabChatGpt" Tag="chatgpt" Content="ChatGPT" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabClaude" Tag="claude" Content="Claude" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabGemini" Tag="gemini" Content="Gemini" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabDeepSeek" Tag="deepseek" Content="DeepSeek" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabDeepL" Tag="deepl" Content="DeepL" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabSettings" Tag="settings" Content="&#xE713;" ToolTip="Настройки" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">

                <!-- ===== Главная ===== -->
                <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,6,24,16">
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock x:Name="HomeTime" Text="00:00" DockPanel.Dock="Left"
                                       Foreground="{StaticResource TextMain}" FontSize="52" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                                <TextBlock x:Name="HomeDate" Foreground="{StaticResource TextMain}" FontSize="17"
                                           FontFamily="{StaticResource UiFont}"/>
                                <TextBlock x:Name="HomeWeather" Foreground="{StaticResource TextDim}" FontSize="15"
                                           FontFamily="Segoe UI Variable Text, Segoe UI Emoji, Segoe UI"
                                           Cursor="Hand" MouseLeftButtonDown="HomeWeather_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Плеер (компактный) -->
                        <Border Style="{StaticResource Card}" Padding="12,10">
                            <Grid>
                                <TextBlock x:Name="PlayerEmpty" Style="{StaticResource Hint}" FontSize="13.5" VerticalAlignment="Center"
                                           Text="Сейчас ничего не играет"/>
                                <Grid x:Name="PlayerContent" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="52" Height="52">
                                        <Image x:Name="CardCover" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,52,52" RadiusX="8" RadiusY="8"/>
                                            </Image.Clip>
                                        </Image>
                                        <Image x:Name="CardAppIcon" Width="16" Height="16" Margin="0,0,-4,-4"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="CardTitle" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextMain}" FontSize="14.5" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource UiFont}"/>
                                        <DockPanel>
                                            <TextBlock x:Name="PosText" DockPanel.Dock="Right" Style="{StaticResource Hint}" FontSize="11.5"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CardArtist" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextDim}" FontSize="12.5"
                                                       FontFamily="{StaticResource UiFont}"/>
                                        </DockPanel>
                                        <Grid x:Name="ProgressArea" Height="10" Margin="0,4,0,0" Background="Transparent"
                                              Cursor="Hand" MouseLeftButtonDown="Progress_Click">
                                            <Border Height="3" CornerRadius="1.5" Background="#33FFFFFF"/>
                                            <Border x:Name="ProgressFill" Height="3" CornerRadius="1.5" Background="#F2F2F5"
                                                    HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RoundIcon}" Width="34" Height="32" Margin="2,0" FontSize="13"
                                                Content="&#xE892;" ToolTip="Предыдущий" Click="Prev_Click"/>
                                        <Button x:Name="PlayPauseButton" Style="{StaticResource RoundIcon}" Width="40" Height="32" Margin="2,0"
                                                FontSize="14" Content="&#xE768;" Click="PlayPause_Click"/>
                                        <Button Style="{StaticResource RoundIcon}" Width="34" Height="32" Margin="2,0" FontSize="13"
                                                Content="&#xE893;" ToolTip="Следующий" Click="Next_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Звук (одна строка + всплывающий список устройств) -->
                        <Border Style="{StaticResource Card}" Padding="10,8">
                            <Grid>
                                <DockPanel>
                                    <Button x:Name="MuteButton" DockPanel.Dock="Left" Style="{StaticResource RoundIcon}" Margin="0"
                                            Width="34" Height="32" FontSize="14" Content="&#xE767;" ToolTip="Без звука" Click="Mute_Click"/>
                                    <Button x:Name="DeviceButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                            Padding="10,6" MaxWidth="230" ToolTip="Куда идёт звук" Click="DeviceButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DeviceButtonText" Margin="8,0" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="VolumePercent" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Margin="0,0,10,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextMain}" FontSize="14"
                                               FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Margin="10,0,0,0"
                                            VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                            ValueChanged="VolumeSlider_ValueChanged"/>
                                </DockPanel>
                                <Popup x:Name="DevicePopup" PlacementTarget="{Binding ElementName=DeviceButton}" Placement="Bottom"
                                       HorizontalOffset="-60" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="#24242C" CornerRadius="10" Padding="6" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <StackPanel x:Name="DevicesPanel" MinWidth="290"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <!-- Таймер выключения -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Таймер выключения" Foreground="{StaticResource TextMain}" FontSize="15"
                                           FontWeight="SemiBold" FontFamily="{StaticResource UiFont}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <RadioButton x:Name="ActShutdown" Content="Выключить" GroupName="PowerAction" IsChecked="True" Style="{StaticResource SettingsRadio}"/>
                                    <RadioButton x:Name="ActRestart" Content="Перезагрузить" GroupName="PowerAction" Style="{StaticResource SettingsRadio}"/>
                                    <RadioButton x:Name="ActSleep" Content="Сон" GroupName="PowerAction" Style="{StaticResource SettingsRadio}"/>
                                    <RadioButton x:Name="ActHibernate" Content="Гибернация" GroupName="PowerAction" Style="{StaticResource SettingsRadio}"/>
                                </WrapPanel>
                                <WrapPanel x:Name="TimerButtons" Margin="0,6,0,0">
                                    <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="15 мин" Tag="15" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="30 мин" Tag="30" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="1 час" Tag="60" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="2 часа" Tag="120" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="После трека" Click="TimerAfterTrack_Click"/>
                                    <TextBox x:Name="TimerCustomBox" Width="110" Padding="6,4" FontSize="13" Margin="0,0,6,6"
                                             Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#44FFFFFF" CaretBrush="#F2F2F5"
                                             ToolTip="Минуты (45) или время (01:30)" KeyDown="TimerCustomBox_KeyDown"/>
                                    <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Старт" Click="TimerCustom_Click"/>
                                </WrapPanel>
                                <DockPanel x:Name="TimerStatusRow" Visibility="Collapsed" Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource FlatButton}" Content="+15 мин" Click="TimerPlus_Click"/>
                                        <Button Style="{StaticResource FlatButton}" Content="Отменить" Click="TimerCancel_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TimerStatus" VerticalAlignment="Center" Foreground="#FFB4AD" FontSize="14"
                                               FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                                </DockPanel>
                                <TextBlock x:Name="TimerHint" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Свободное поле: число минут (45) или время (01:30). За минуту до срабатывания пилюля предупредит — нажми на неё, чтобы отменить."/>
                            </StackPanel>
                        </Border>

                        <!-- Steam -->
                        <Border x:Name="SteamCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Image x:Name="SteamCardIcon" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Steam" Foreground="{StaticResource TextMain}" FontSize="15"
                                               FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                                </StackPanel>
                                <StackPanel x:Name="SteamList"/>
                            </StackPanel>
                        </Border>

                        <!-- Уведомления -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="ClearNotificationsButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                            Content="Очистить всё" Padding="10,4" Click="ClearNotifications_Click"/>
                                    <TextBlock Text="Уведомления" Foreground="{StaticResource TextMain}" FontSize="15"
                                               FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                                </DockPanel>
                                <StackPanel x:Name="NotificationsList"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="HomeHint" Style="{StaticResource Hint}" LineHeight="19" Margin="2,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Буфер обмена ===== -->
                <Grid x:Name="ClipboardView" Visibility="Collapsed" Margin="24,6,24,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Очистить"
                                ToolTip="Удалить всё, кроме закреплённого" Click="ClipClear_Click"/>
                        <TextBlock Text="&#xE721;" DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" FontSize="15"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ClipSearch" Padding="8,5" FontSize="14"
                                 Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#44FFFFFF" CaretBrush="#F2F2F5"
                                 ToolTip="Поиск по истории" TextChanged="ClipSearch_TextChanged"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ClipList"/>
                    </ScrollViewer>
                </Grid>

                <!-- ===== Погода ===== -->
                <ScrollViewer x:Name="WeatherView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="WeatherContent" Margin="24,6,24,20"/>
                </ScrollViewer>

                <!-- ===== ИИ-чаты: WebView2 создаются при первом открытии вкладки ===== -->
                <Grid x:Name="AiHost" Visibility="Collapsed"/>

                <!-- ===== Настройки ===== -->
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,4,28,28" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Общее" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="AutoStartBox" Content="Запускать вместе с Windows"
                                  Style="{StaticResource SettingsCheck}" Click="Setting_Changed"/>
                        <CheckBox x:Name="OpenOnHoverBox" Content="Раскрывать остров при наведении (иначе — по клику)"
                                  Style="{StaticResource SettingsCheck}" Click="Setting_Changed"/>
                        <CheckBox x:Name="AutoHideBox" Content="Прятать остров за верхний край, когда не нужен"
                                  Style="{StaticResource SettingsCheck}" Click="Setting_Changed"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="26,0,0,0"
                                   Text="Чтобы вернуть, упри курсор в самый верх экрана над пилюлей."/>

                        <TextBlock Text="Пилюля" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="EyesBox" Content="Глаза, которые следят за курсором"
                                  Style="{StaticResource SettingsCheck}" Click="Setting_Changed"/>
                        <WrapPanel Margin="0,4,0,0">
                            <RadioButton x:Name="ModeBoth" Content="Глаза и часы" Style="{StaticResource SettingsRadio}" Click="Setting_Changed"/>
                            <RadioButton x:Name="ModeEyes" Content="Только глаза" Style="{StaticResource SettingsRadio}" Click="Setting_Changed"/>
                            <RadioButton x:Name="ModeClock" Content="Только часы" Style="{StaticResource SettingsRadio}" Click="Setting_Changed"/>
                        </WrapPanel>
                        <CheckBox x:Name="MusicPillBox" Content="Показывать играющий трек в пилюле"
                                  Style="{StaticResource SettingsCheck}" Click="Setting_Changed"/>
                        <CheckBox x:Name="WeatherPillBox" Content="Показывать погоду в пилюле"
                                  Style="{StaticResource SettingsCheck}" Click="Setting_Changed"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Колёсико мыши над пилюлей меняет громкость. Чтобы переместить пилюлю: правый клик → «Открепить и переместить», перетащи, затем «Закрепить здесь»."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource FlatButton}" Margin="0" Content="Вернуть пилюлю по центру" Click="ResetPill_Click"/>
                        </StackPanel>

                        <TextBlock Text="Погода" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="WeatherCityText" Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="CitySearchBox" Width="260" Padding="8,5" FontSize="14"
                                     Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#44FFFFFF"
                                     CaretBrush="#F2F2F5" KeyDown="CitySearchBox_KeyDown"/>
                            <Button Style="{StaticResource FlatButton}" Content="Найти город" Click="CitySearch_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="CityResults" Margin="0,8,0,0"/>

                        <TextBlock Text="Уведомления" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="NotificationsBox" Content="Показывать уведомления программ на острове"
                                  Style="{StaticResource SettingsCheck}" Click="Setting_Changed"/>
                        <TextBlock x:Name="NotificationsInfo" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Нажатие на карточку открывает программу. Ниже — программы, от которых уже приходили уведомления: сними галочку, чтобы их не показывать."/>
                        <StackPanel x:Name="NotificationApps"/>

                        <TextBlock Text="Горячая клавиша" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HotkeyBox" Width="220" Padding="8,5" FontSize="14"
                                     Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#44FFFFFF"
                                     CaretBrush="#F2F2F5"/>
                            <Button Style="{StaticResource FlatButton}" Content="Применить" Click="ApplyHotkey_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Например: Ctrl+Alt+Space, Win+Shift+I, Alt+Q"/>

                        <TextBlock Text="ИИ-чаты" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="ChatGPT, Claude, Gemini, DeepSeek и переводчик DeepL открываются как сайты. Войди в свои аккаунты один раз — вход сохранится. Данные браузера лежат в %LocalAppData%\WikarIsland\WebView2."/>

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Style="{StaticResource FlatButton}" Margin="0" Content="Выйти из Wikar Island" Click="Quit_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
