<Window x:Class="WikarIsland.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WikarIsland.Controls"
        Title="Wikar Island"
        Width="530" Height="600"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Background="#FF0B0B0E"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#17171D"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="RoundIcon" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Большая белая круглая кнопка паузы -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#0B0B0E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="#F5F5F7"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#D8D8DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Большая плитка центра управления -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#1E1E25"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Width" Value="152"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Background="{TemplateBinding Background}" Padding="14,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитки быстрых действий на «Главной» -->
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#17171D"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="14" Background="{TemplateBinding Background}" Padding="14,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#222229"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionIcon" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ActionSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#A0A0AA"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Центр управления: подпись секции капслоком -->
        <Style x:Key="CapsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A94"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Блок центра управления: чуть светлее фона, мягкие углы -->
        <Style x:Key="CcCard" TargetType="Border">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="BorderBrush" Value="#0FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <!-- Круглый переключатель: кружок со значком, подпись и состояние под ним -->
        <Style x:Key="CircleToggle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Circle" TargetType="Border">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Background" Value="#2A2A31"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CircleIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CircleLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CircleState" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7C7C86"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="96"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Текстовая кнопка со значком (строка питания) -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#C8C8D0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="10,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Маленькая кнопка-пилюля с обводкой: «30 мин», «1 ч» -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#D8D8DE"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="10,4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладка-значок: подпись видна только у выбранной -->
        <Style x:Key="IconTab" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
            <Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="17" Padding="9,7" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===== Настройки: меню разделов слева и карточки справа ===== -->
        <Style x:Key="SetNav" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsNav"/>
            <Setter Property="Foreground" Value="#C9C9D2"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="9" Padding="10,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#248EA2FF"/>
                                <Setter Property="Foreground" Value="#8EA2FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SetTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SetSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8C8C97"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SetGroup" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8C8C97"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SetCard" TargetType="Border">
            <Setter Property="Background" Value="#17171D"/>
            <Setter Property="BorderBrush" Value="#22222A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,6,12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SetHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#8C8C97"/>
        </Style>
        <!-- переключатель: подпись слева (с переносом), тумблер справа -->
        <Style x:Key="SetCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Border x:Name="Track" Grid.Column="1" Width="34" Height="18" CornerRadius="9" Background="#2E2E38" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#A0A0AA" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#8EA2FF"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#0B0B0E"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetRadio" TargetType="RadioButton" BasedOn="{StaticResource SettingsRadio}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,4,14,4"/>
        </Style>
        <Style x:Key="SetBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="#1F1F24"/>
            <Setter Property="Foreground" Value="#F2F2F5"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="CaretBrush" Value="#F2F2F5"/>
        </Style>
        <Style x:Key="SetPassword" TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="#1F1F24"/>
            <Setter Property="Foreground" Value="#F2F2F5"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="CaretBrush" Value="#F2F2F5"/>
        </Style>
        <Style x:Key="SetButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <!-- «?» рядом с заголовком: длинное пояснение открывается по клику -->
        <Style x:Key="HelpToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Подробнее"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="9" Background="#22222A" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="?" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0AA"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34343C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4580"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Мини-капсула: в неё «свернулась» пилюля. Клик — свернуть остров обратно -->
        <Border x:Name="Capsule" HorizontalAlignment="Center" Margin="0,8,0,4" Padding="14,5"
                CornerRadius="14" Background="#16161C" Cursor="Hand" ToolTip="Свернуть остров"
                MouseLeftButtonDown="Capsule_Down" MouseLeftButtonUp="Capsule_Click">
            <StackPanel Orientation="Horizontal">
                <controls:EyesControl x:Name="CapsuleEyes" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="CapsuleTime" Text="00:00" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- Вкладки -->
        <DockPanel Grid.Row="1" Margin="8,2,8,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReloadButton" Style="{StaticResource RoundIcon}" Width="30" Margin="1,0" FontSize="13"
                        Content="&#xE72C;" ToolTip="Обновить страницу" Click="Reload_Click"/>
                <Button x:Name="PopOutButton" Style="{StaticResource RoundIcon}" Width="30" Margin="1,0" FontSize="13"
                        Content="&#xE8A7;" ToolTip="Открыть в отдельном окне" Click="PopOut_Click"/>
                <Border Width="1" Height="16" Background="#26FFFFFF" Margin="5,0,6,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="TabVpn" Tag="vpn" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="VPN">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="VPN" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabZapret" Tag="zapret" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="zapret">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="zapret" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabSettings" Tag="settings" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Настройки">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Настройки" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <!-- Остальные вкладки: если не влезают, обрезаются они, а VPN, zapret и настройки справа видны всегда -->
            <ScrollViewer x:Name="TabsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="TabsScroll_Wheel" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabHome" Tag="home" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Главная">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Главная" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabCenter" Tag="control" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Центр управления">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Центр" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabSystem" Tag="system" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Показатели ПК">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Система" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabWeather" Tag="weather" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Погода">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Погода" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabClipboard" Tag="clipboard" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Буфер обмена">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Буфер" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabMusic" Tag="music" Style="{StaticResource IconTab}" Checked="Tab_Checked" ToolTip="Музыка: Яндекс Музыка, YouTube Music, Spotify">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Музыка" Margin="7,0,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabChatGpt" Tag="chatgpt" Content="GPT" ToolTip="ChatGPT" Style="{StaticResource IconTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabClaude" Tag="claude" Content="Claude" Style="{StaticResource IconTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabGemini" Tag="gemini" Content="Gemini" Style="{StaticResource IconTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabDeepSeek" Tag="deepseek" Content="DS" ToolTip="DeepSeek" Style="{StaticResource IconTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabDeepL" Tag="deepl" Content="DeepL" ToolTip="Переводчик DeepL" Style="{StaticResource IconTab}" Checked="Tab_Checked"/>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Grid Grid.Row="2">

            <!-- ===== Главная ===== -->
            <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,12">

                    <!-- Погода и дата -->
                    <Border Style="{StaticResource Card}" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="HomeWeather_Click">
                        <DockPanel>
                            <TextBlock x:Name="HomeDate" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" FontSize="13" FontFamily="{StaticResource UiFont}"/>
                            <controls:WeatherIcon x:Name="HomeWeatherIcon" Width="30" Height="30" Margin="0,0,10,0"/>
                            <TextBlock x:Name="HomeWeather" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextMain}" FontSize="14" FontFamily="{StaticResource UiFont}"/>
                        </DockPanel>
                    </Border>

                    <!-- Плеер и звук слева, быстрые действия справа -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <!-- Плеер -->
                            <Border x:Name="PlayerCard" Style="{StaticResource Card}" Padding="14">
                                <Grid>
                                    <TextBlock x:Name="PlayerEmpty" Style="{StaticResource Hint}" FontSize="13.5"
                                               Text="Сейчас ничего не играет"/>
                                    <Grid x:Name="PlayerContent" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="CardCover" Width="104" Height="104" Stretch="UniformToFill" VerticalAlignment="Top">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,104,104" RadiusX="12" RadiusY="12"/>
                                            </Image.Clip>
                                        </Image>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Image x:Name="CardAppIcon" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CardSource" Foreground="{StaticResource TextDim}" FontSize="11"
                                                           FontWeight="SemiBold" FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CardTitle" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextMain}" FontSize="17" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource UiFont}"/>
                                            <TextBlock x:Name="CardArtist" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextDim}" FontSize="13.5"
                                                       FontFamily="{StaticResource UiFont}"/>
                                            <Grid x:Name="ProgressArea" Height="12" Margin="0,12,0,0" Background="Transparent"
                                                  Cursor="Hand" MouseLeftButtonDown="Progress_Click">
                                                <Border Height="4" CornerRadius="2" Background="#33FFFFFF"/>
                                                <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Background="#F2F2F5"
                                                        HorizontalAlignment="Left" Width="0"/>
                                            </Grid>
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock x:Name="RemainText" DockPanel.Dock="Right" Style="{StaticResource Hint}" FontSize="11"/>
                                                <TextBlock x:Name="PosText" Style="{StaticResource Hint}" FontSize="11"/>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                <Button Style="{StaticResource RoundIcon}" Content="&#xE892;" ToolTip="Предыдущий" Click="Prev_Click"/>
                                                <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Content="&#xE768;" Click="PlayPause_Click"/>
                                                <Button Style="{StaticResource RoundIcon}" Content="&#xE893;" ToolTip="Следующий" Click="Next_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Звук -->
                            <Border Style="{StaticResource Card}" Padding="10,8">
                                <Grid>
                                    <DockPanel>
                                        <Button x:Name="MuteButton" DockPanel.Dock="Left" Style="{StaticResource RoundIcon}" Margin="0"
                                                Width="34" Height="32" FontSize="14" Content="&#xE767;" ToolTip="Без звука" Click="Mute_Click"/>
                                        <Button x:Name="DeviceButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                                Padding="10,6" MaxWidth="170" ToolTip="Куда идёт звук" Click="DeviceButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DeviceButtonText" Margin="7,0" MaxWidth="100" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="VolumePercent" DockPanel.Dock="Right" Width="38" TextAlignment="Right" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextMain}" FontSize="14"
                                                   FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Margin="8,0,0,0"
                                                VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                ValueChanged="VolumeSlider_ValueChanged"/>
                                    </DockPanel>
                                    <Popup x:Name="DevicePopup" PlacementTarget="{Binding ElementName=DeviceButton}" Placement="Bottom"
                                           HorizontalOffset="-140" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="#24242C" CornerRadius="10" Padding="6" BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <StackPanel x:Name="DevicesPanel" MinWidth="290"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <!-- Быстрые действия -->
                        <UniformGrid Grid.Column="1" Columns="2" Margin="10,0,0,0" VerticalAlignment="Top">
                            <Button x:Name="TimerTileButton" Style="{StaticResource ActionTile}" Click="TimerTile_Click">
                                <DockPanel>
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource ActionIcon}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Таймер выключения" Style="{StaticResource ActionText}"/>
                                        <TextBlock x:Name="TimerTileState" Style="{StaticResource ActionSub}" Visibility="Collapsed"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="FocusTile_Click">
                                <DockPanel>
                                    <TextBlock Text="&#xE916;" Style="{StaticResource ActionIcon}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Таймер и напоминания" Style="{StaticResource ActionText}"/>
                                        <TextBlock x:Name="FocusTileState" Style="{StaticResource ActionSub}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="NotesTile_Click">
                                <DockPanel>
                                    <TextBlock Text="&#xE70B;" Style="{StaticResource ActionIcon}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Заметки" Style="{StaticResource ActionText}"/>
                                        <TextBlock x:Name="NotesTileState" Style="{StaticResource ActionSub}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="RecordTile_Click" ToolTip="Запись экрана, на котором стоит пилюля, в MP4 (без звука). Остановить — клик по пилюле">
                                <DockPanel>
                                    <TextBlock x:Name="RecordTileIcon" Text="&#xE714;" Style="{StaticResource ActionIcon}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="RecordTileText" Text="Запись экрана" Style="{StaticResource ActionText}"/>
                                        <TextBlock x:Name="RecordTileState" Text="идёт запись" Style="{StaticResource ActionSub}" Foreground="#FF8A80" Visibility="Collapsed"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button x:Name="AudioTile" Style="{StaticResource ActionTile}" Click="AudioTile_Click"
                                    ToolTip="Запись звука из колонок, с микрофона или обоих сразу (.m4a)">
                                <DockPanel>
                                    <TextBlock x:Name="AudioTileIcon" Text="&#xE720;" Style="{StaticResource ActionIcon}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="AudioTileText" Text="Запись звука" Style="{StaticResource ActionText}"/>
                                        <TextBlock x:Name="AudioTileState" Style="{StaticResource ActionSub}" Foreground="#FF8A80" Visibility="Collapsed"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="AreaTile_Click" ToolTip="Скриншот выделенной области (Win+Shift+S)">
                                <DockPanel>
                                    <TextBlock Text="&#xE8B3;" Style="{StaticResource ActionIcon}"/>
                                    <TextBlock Text="Область" Style="{StaticResource ActionText}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Click="FullTile_Click" ToolTip="Снимок всего экрана: в папку «Изображения\Screenshots» и в буфер">
                                <DockPanel>
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource ActionIcon}"/>
                                    <TextBlock Text="Весь экран" Style="{StaticResource ActionText}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>

                    <!-- Ярлыки -->
                    <Border x:Name="LauncherCard" Style="{StaticResource Card}" Padding="12,10" AllowDrop="True"
                            Drop="Launcher_Drop" DragOver="Launcher_DragOver">
                        <StackPanel>
                            <DockPanel Margin="2,0,0,8">
                                <Button x:Name="DesktopIconsButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                        Padding="9,4" FontSize="12" Click="DesktopIcons_Click"/>
                                <TextBlock Text="Ярлыки" VerticalAlignment="Center" Foreground="{StaticResource TextMain}"
                                           FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            </DockPanel>
                            <WrapPanel x:Name="LauncherPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- Steam -->
                    <Border x:Name="SteamCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image x:Name="SteamCardIcon" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Steam" Foreground="{StaticResource TextMain}" FontSize="14"
                                           FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                            <StackPanel x:Name="SteamList"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="HomeHint" Style="{StaticResource Hint}" LineHeight="18" Margin="4,2,4,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Таймер выключения (из плитки) ===== -->
            <ScrollViewer x:Name="TimerView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,12">
                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Click="Back_Click"
                            Background="Transparent" Content="&#x2190;  Назад"/>
                    <!-- Таймер выключения -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Таймер выключения" Foreground="{StaticResource TextMain}" FontSize="14"
                                       FontWeight="SemiBold" FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <RadioButton x:Name="ActShutdown" Content="Выключить" GroupName="PowerAction" IsChecked="True" Style="{StaticResource SettingsRadio}" FontSize="13"/>
                                <RadioButton x:Name="ActRestart" Content="Перезагрузить" GroupName="PowerAction" Style="{StaticResource SettingsRadio}" FontSize="13"/>
                                <RadioButton x:Name="ActSleep" Content="Сон" GroupName="PowerAction" Style="{StaticResource SettingsRadio}" FontSize="13"/>
                                <RadioButton x:Name="ActHibernate" Content="Гибернация" GroupName="PowerAction" Style="{StaticResource SettingsRadio}" FontSize="13"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="15 мин" Tag="15" Click="TimerPreset_Click"/>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="30 мин" Tag="30" Click="TimerPreset_Click"/>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="1 ч" Tag="60" Click="TimerPreset_Click"/>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="2 ч" Tag="120" Click="TimerPreset_Click"/>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="После трека" Click="TimerAfterTrack_Click"/>
                                <TextBox x:Name="TimerCustomBox" Width="70" Padding="6,4" FontSize="13" Margin="0,0,6,6"
                                         Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#44FFFFFF" CaretBrush="#F2F2F5"
                                         ToolTip="Минуты (45) или время (01:30)" KeyDown="TimerCustomBox_KeyDown"/>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Старт" Click="TimerCustom_Click"/>
                            </WrapPanel>
                            <DockPanel x:Name="TimerStatusRow" Visibility="Collapsed" Margin="0,2,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource FlatButton}" Content="+15" Click="TimerPlus_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Content="Отменить" Click="TimerCancel_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="TimerStatus" VerticalAlignment="Center" Foreground="#FFB4AD" FontSize="13.5"
                                           FontWeight="SemiBold" FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock x:Name="TimerHint" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Поле: минуты (45) или время (01:30). За минуту пилюля предупредит — нажми на неё, чтобы отменить."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== Заметки (из плитки) ===== -->
            <!-- Таймер, Pomodoro и напоминания -->
            <ScrollViewer x:Name="FocusView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,12">
                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Click="Back_Click"
                            Background="Transparent" Content="&#x2190;  Назад"/>
                    <StackPanel x:Name="FocusContent"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="NotesView" Visibility="Collapsed" Margin="14,0,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Margin="0" Background="Transparent"
                            Content="&#x2190;  Назад" Click="NotesBack_Click"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="NoteDeleteButton" Style="{StaticResource FlatButton}" Content="Удалить" Click="NoteDelete_Click" Visibility="Collapsed"/>
                        <Button x:Name="NoteNewButton" Style="{StaticResource FlatButton}" Content="+ Новая" Click="NoteNew_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="NotesHeader" Text="Заметки" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                </DockPanel>
                <ScrollViewer x:Name="NotesListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NotesList"/>
                </ScrollViewer>
                <TextBox x:Name="NoteEditor" Grid.Row="1" Visibility="Collapsed"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Padding="12,10" FontSize="14.5" FontFamily="{StaticResource UiFont}"
                         Background="#17171D" Foreground="#F2F2F5" BorderThickness="0" CaretBrush="#F2F2F5"
                         TextChanged="NoteEditor_TextChanged"/>
            </Grid>

            <!-- ===== zapret: дополнительные опции (как service.bat) ===== -->
            <ScrollViewer x:Name="ZapretView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,0,16,16">
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Margin="0" Background="Transparent"
                                Content="&#x2190;  Назад" Click="ZapretBack_Click"/>
                        <TextBlock Text="zapret — дополнительно" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                    </DockPanel>
                    <TextBlock x:Name="ZapretToolMessage" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ZapretAdvanced"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Центр управления (в духе Atoll) ===== -->
            <ScrollViewer x:Name="ControlView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,2,14,14">

                    <!-- Пункт управления: переключатели и питание -->
                    <Border Style="{StaticResource CcCard}" Padding="16,12,16,8">
                        <StackPanel>
                            <TextBlock Text="ПУНКТ УПРАВЛЕНИЯ" Style="{StaticResource CapsLabel}"/>
                            <UniformGrid Columns="5" Margin="0,12,0,0">
                                <Button x:Name="WifiTile" Style="{StaticResource CircleToggle}" Click="WifiTile_Click">
                                    <StackPanel>
                                        <Border x:Name="WifiCircle" Style="{StaticResource Circle}">
                                            <TextBlock Text="&#xE701;" Style="{StaticResource CircleIcon}"/>
                                        </Border>
                                        <TextBlock Text="Wi-Fi" Style="{StaticResource CircleLabel}"/>
                                        <TextBlock x:Name="WifiState" Style="{StaticResource CircleState}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BluetoothTile" Style="{StaticResource CircleToggle}" Click="BluetoothTile_Click">
                                    <StackPanel>
                                        <Border x:Name="BluetoothCircle" Style="{StaticResource Circle}">
                                            <TextBlock Text="&#xE702;" Style="{StaticResource CircleIcon}"/>
                                        </Border>
                                        <TextBlock Text="Bluetooth" Style="{StaticResource CircleLabel}"/>
                                        <TextBlock x:Name="BluetoothState" Style="{StaticResource CircleState}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="VpnTile" Style="{StaticResource CircleToggle}" Click="VpnTile_Click">
                                    <StackPanel>
                                        <Border x:Name="VpnCircle" Style="{StaticResource Circle}">
                                            <TextBlock Text="&#xEA18;" Style="{StaticResource CircleIcon}"/>
                                        </Border>
                                        <TextBlock Text="VPN" Style="{StaticResource CircleLabel}"/>
                                        <TextBlock x:Name="VpnState" Style="{StaticResource CircleState}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ZapretTile" Style="{StaticResource CircleToggle}" Click="ZapretTile_Click">
                                    <StackPanel>
                                        <Border x:Name="ZapretCircle" Style="{StaticResource Circle}">
                                            <TextBlock Text="&#xE945;" Style="{StaticResource CircleIcon}"/>
                                        </Border>
                                        <TextBlock Text="zapret" Style="{StaticResource CircleLabel}"/>
                                        <TextBlock x:Name="ZapretTileState" Style="{StaticResource CircleState}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="IconsTile" Style="{StaticResource CircleToggle}" Click="DesktopIcons_Click">
                                    <StackPanel>
                                        <Border x:Name="IconsCircle" Style="{StaticResource Circle}">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource CircleIcon}"/>
                                        </Border>
                                        <TextBlock Text="Чистый стол" Style="{StaticResource CircleLabel}"/>
                                        <TextBlock x:Name="IconsState" Style="{StaticResource CircleState}"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <TextBlock x:Name="RadioHint" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,8,0,0" Visibility="Collapsed"/>

                            <WrapPanel Margin="-6,10,0,0">
                                <Button Style="{StaticResource LinkButton}" Tag="lock" Click="Power_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Блокировка" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource LinkButton}" Tag="sleep" Click="Power_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Сон" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource LinkButton}" Tag="restart" Click="Power_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Перезагрузка" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource LinkButton}" Tag="shutdown" Click="Power_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Выключение" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Подтверждение выключения/перезагрузки -->
                            <Border x:Name="PowerConfirm" Visibility="Collapsed" Margin="0,6,0,6" Padding="12,8"
                                    CornerRadius="12" Background="#2A1A1C">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource FlatButton}" Content="Отмена" Click="PowerCancel_Click"/>
                                        <Button x:Name="PowerConfirmButton" Style="{StaticResource FlatButton}" Background="#B3261E" Click="PowerConfirm_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PowerConfirmText" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMain}" FontSize="13" FontFamily="{StaticResource UiFont}"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Показатели ПК: клик — вкладка «Система» -->
                    <UniformGrid Columns="3" Margin="0,10,0,0">
                        <Border Style="{StaticResource CcCard}" Margin="0,0,5,0" Cursor="Hand" MouseLeftButtonUp="CcStats_Click">
                            <StackPanel>
                                <TextBlock Text="ПРОЦЕССОР" Style="{StaticResource CapsLabel}"/>
                                <TextBlock x:Name="CcCpuValue" Text="—" Margin="0,6,0,0" FontSize="22" Foreground="{StaticResource TextMain}"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                <ContentControl x:Name="CcCpuBar" Margin="0,4,0,2"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CcCard}" Margin="5,0,5,0" Cursor="Hand" MouseLeftButtonUp="CcStats_Click">
                            <StackPanel>
                                <TextBlock x:Name="CcGpuTitle" Text="ВИДЕОКАРТА" Style="{StaticResource CapsLabel}"/>
                                <TextBlock x:Name="CcGpuValue" Text="—" Margin="0,6,0,0" FontSize="22" Foreground="{StaticResource TextMain}"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                <ContentControl x:Name="CcGpuBar" Margin="0,4,0,2"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CcCard}" Margin="5,0,0,0" Cursor="Hand" MouseLeftButtonUp="CcStats_Click">
                            <StackPanel>
                                <TextBlock Text="ПАМЯТЬ" Style="{StaticResource CapsLabel}"/>
                                <TextBlock x:Name="CcRamValue" Text="—" Margin="0,6,0,0" FontSize="22" Foreground="{StaticResource TextMain}"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                <ContentControl x:Name="CcRamBar" Margin="0,4,0,2"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Не беспокоить и таймер выключения -->
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Border Style="{StaticResource CcCard}" Margin="0,0,5,0">
                            <StackPanel>
                                <DockPanel Cursor="Hand" Background="Transparent" MouseLeftButtonUp="CcDnd_Click" ToolTip="Включить или выключить">
                                    <Border x:Name="CcDndCircle" Style="{StaticResource Circle}" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE708;" Style="{StaticResource CircleIcon}" FontSize="14"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Не беспокоить" Foreground="{StaticResource TextMain}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CcDndState" Foreground="#8A8A94" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource Chip}" Content="30 мин" Tag="30" Click="CcDndFor_Click"/>
                                    <Button Style="{StaticResource Chip}" Content="1 ч" Tag="60" Click="CcDndFor_Click"/>
                                    <Button Style="{StaticResource Chip}" Content="2 ч" Tag="120" Click="CcDndFor_Click"/>
                                    <Button x:Name="CcDndOff" Style="{StaticResource LinkButton}" Content="Выключить" FontSize="12" Click="CcDndOff_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CcCard}" Margin="5,0,0,0">
                            <StackPanel>
                                <DockPanel Cursor="Hand" Background="Transparent" MouseLeftButtonUp="CcTimer_Click" ToolTip="Другие варианты таймера">
                                    <Border x:Name="CcTimerCircle" Style="{StaticResource Circle}" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE916;" Style="{StaticResource CircleIcon}" FontSize="14"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Таймер выключения" Foreground="{StaticResource TextMain}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CcTimerState" Text="Выключен" Foreground="#8A8A94" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource Chip}" Content="30 мин" Tag="30" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource Chip}" Content="1 ч" Tag="60" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource Chip}" Content="2 ч" Tag="120" Click="TimerPreset_Click"/>
                                    <Button x:Name="CcTimerCancel" Style="{StaticResource LinkButton}" Content="Отменить" FontSize="12" Click="TimerCancel_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Уведомления -->
                    <Border Style="{StaticResource CcCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="ClearNotificationsButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                        Content="Очистить всё" FontSize="12" Margin="0,-6,-6,-6" Click="ClearNotifications_Click"/>
                                <TextBlock Text="УВЕДОМЛЕНИЯ" Style="{StaticResource CapsLabel}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel x:Name="NotificationsList"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== VPN ===== -->
            <ScrollViewer x:Name="VpnView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,2,14,16">
                    <Border Style="{StaticResource CcCard}">
                        <DockPanel>
                            <Button x:Name="VpnPowerButton" DockPanel.Dock="Right" Style="{StaticResource CircleToggle}" Click="VpnTile_Click" VerticalAlignment="Center">
                                <Border x:Name="VpnPowerCircle" Style="{StaticResource Circle}" Width="44" Height="44" CornerRadius="22">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource CircleIcon}" FontSize="16"/>
                                </Border>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="VPN (VLESS)" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="VpnHeaderState" Foreground="#8A8A94" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CcCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="СЕРВЕРЫ" Style="{StaticResource CapsLabel}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="VpnServersList"/>
                            <TextBox x:Name="VpnLinkBox" Height="58" Padding="8,5" Margin="0,10,0,0" FontSize="12.5" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"
                                     Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#33FFFFFF" CaretBrush="#F2F2F5"
                                     ToolTip="Одна или несколько ссылок vless://, каждая с новой строки"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource FlatButton}" Margin="0" Content="Добавить" Click="VpnAdd_Click"/>
                                <TextBlock x:Name="VpnAddStatus" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" FontSize="11.5"
                                       Text="Ядро Xray, трафик идёт через системный прокси Windows. Ссылки хранятся зашифрованными."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CcCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="DNS" Style="{StaticResource CapsLabel}" Margin="0,0,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Сохранить" Click="VpnDnsSave_Click"/>
                                <TextBox x:Name="VpnDnsBox" Padding="8,5" FontSize="12.5" FontFamily="Cascadia Mono, Consolas"
                                         Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#33FFFFFF" CaretBrush="#F2F2F5"
                                         ToolTip="Через запятую: 1.1.1.1 или https://…/dns-query. Пусто — как в системе"/>
                            </DockPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource Chip}" Margin="0,0,6,6" Content="Cloudflare" Tag="https://1.1.1.1/dns-query, 1.1.1.1" Click="VpnDnsPreset_Click"/>
                                <Button Style="{StaticResource Chip}" Margin="0,0,6,6" Content="Google" Tag="https://dns.google/dns-query, 8.8.8.8" Click="VpnDnsPreset_Click"/>
                                <Button Style="{StaticResource Chip}" Margin="0,0,6,6" Content="AdGuard" ToolTip="Без рекламы" Tag="https://dns.adguard-dns.com/dns-query, 94.140.14.14" Click="VpnDnsPreset_Click"/>
                                <Button Style="{StaticResource Chip}" Margin="0,0,6,6" Content="Quad9" Tag="https://dns.quad9.net/dns-query, 9.9.9.9" Click="VpnDnsPreset_Click"/>
                                <Button Style="{StaticResource Chip}" Margin="0,0,6,6" Content="Системный" Tag="" Click="VpnDnsPreset_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="VpnDnsStatus" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="VpnPillBox" Content="Кнопка VPN в капсуле (пока подключён — видна всегда)"
                              Style="{StaticResource SettingsCheck}" FontSize="13" Margin="4,12,0,0" Click="VpnPill_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== zapret ===== -->
            <ScrollViewer x:Name="ZapretMainView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,2,14,16">
                    <Border Style="{StaticResource CcCard}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource CircleToggle}" Click="ZapretTile_Click" VerticalAlignment="Center">
                                <Border x:Name="ZapretPowerCircle" Style="{StaticResource Circle}" Width="44" Height="44" CornerRadius="22">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource CircleIcon}" FontSize="16"/>
                                </Border>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="zapret" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ZapretStatusText" Foreground="#8A8A94" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CcCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="СТРАТЕГИЯ" Style="{StaticResource CapsLabel}" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="ZapretStrategies"/>
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,2,0,-4" Click="ZapretFind_Click"
                                    ToolTip="Перебрать стратегии и найти ту, при которой работают Discord и YouTube">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Подобрать автоматически" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CcCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="УСТАНОВКА" Style="{StaticResource CapsLabel}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button x:Name="ZapretInstallButton" Style="{StaticResource FlatButton}" Margin="0,0,6,6" Click="ZapretInstall_Click"/>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Дополнительно…" Click="ZapretAdvanced_Click"/>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Папка" Click="ZapretFolder_Click"/>
                                <Button x:Name="ZapretRemoveButton" Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Удалить" Click="ZapretRemove_Click"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="11.5"
                                       Text="Обход замедления Discord и YouTube через DPI (Flowseal/zapret-discord-youtube). Нужны права администратора; если антивирус ругается на WinDivert, добавь папку в исключения."/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ZapretAutoBox" Content="Включать при запуске острова" Style="{StaticResource SettingsCheck}"
                              FontSize="13" Margin="4,12,0,0" Click="ZapretOptions_Click"/>
                    <CheckBox x:Name="ZapretPillBox" Content="Кнопка zapret в капсуле (пока работает — видна всегда)" Style="{StaticResource SettingsCheck}"
                              FontSize="13" Margin="4,4,0,0" Click="ZapretOptions_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Система: показатели ПК ===== -->
            <ScrollViewer x:Name="SystemView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SystemContent" Margin="14,0,14,14"/>
            </ScrollViewer>

            <!-- ===== Погода ===== -->
            <ScrollViewer x:Name="WeatherView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="WeatherContent" Margin="18,4,18,16"/>
            </ScrollViewer>

            <!-- ===== Буфер обмена ===== -->
            <Grid x:Name="ClipboardView" Visibility="Collapsed" Margin="14,2,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Очистить"
                            ToolTip="Удалить всё, кроме закреплённого" Click="ClipClear_Click"/>
                    <TextBlock Text="&#xE721;" DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" FontSize="15"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <TextBox x:Name="ClipSearch" Padding="8,5" FontSize="14"
                             Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#44FFFFFF" CaretBrush="#F2F2F5"
                             ToolTip="Поиск по истории" TextChanged="ClipSearch_TextChanged"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ClipList"/>
                </ScrollViewer>
            </Grid>

            <!-- ===== Музыка: встроенный плеер Яндекс Музыки, YouTube Music и Spotify ===== -->
            <Grid x:Name="MusicView" Visibility="Collapsed" Margin="14,2,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- сервисы и аккаунт -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="MusicAccountText" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,8,0" MaxWidth="230" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="MusicLoginButton" Style="{StaticResource FlatButton}" Margin="0" Content="Войти" Click="MusicLogin_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MusicYandexChip" Style="{StaticResource Chip}" Content="Яндекс Музыка" Tag="yandex" Click="MusicProvider_Click"/>
                        <Button x:Name="MusicYoutubeChip" Style="{StaticResource Chip}" Content="YouTube Music" Tag="youtube" Click="MusicProvider_Click"/>
                        <Button x:Name="MusicSpotifyChip" Style="{StaticResource Chip}" Content="Spotify" Tag="spotify" Click="MusicProvider_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Spotify: свой Client ID -->
                <Border x:Name="MusicSpotifySetup" Grid.Row="1" Style="{StaticResource CcCard}" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap"
                                   Text="Spotify пускает сторонние программы только через своё приложение разработчика (бесплатно, один раз): developer.spotify.com → Dashboard → Create app. В Redirect URI впиши адрес ниже, отметь Web API, сохрани и скопируй сюда Client ID. Звук играет приложение Spotify, остров им управляет; управление требует Premium."/>
                        <TextBox x:Name="MusicSpotifyRedirect" IsReadOnly="True" Margin="0,8,0,0" Padding="8,4" FontSize="12"
                                 FontFamily="Cascadia Mono, Consolas" Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#33FFFFFF"
                                 ToolTip="Скопируй в Redirect URIs приложения Spotify"/>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Сохранить" Click="MusicSpotifyId_Click"/>
                            <TextBox x:Name="MusicSpotifyIdBox" Padding="8,5" FontSize="12.5" FontFamily="Cascadia Mono, Consolas"
                                     Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#33FFFFFF" CaretBrush="#F2F2F5"
                                     ToolTip="Client ID приложения Spotify"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- поиск и подборки -->
                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button x:Name="MusicFavButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Мне нравится" Click="MusicFav_Click"/>
                    <Button x:Name="MusicMixButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Моя волна" Click="MusicMix_Click"/>
                    <TextBlock Text="&#xE721;" DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" FontSize="15"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <TextBox x:Name="MusicSearchBox" Padding="8,5" FontSize="14" VerticalContentAlignment="Center"
                             Background="#1F1F24" Foreground="#F2F2F5" BorderBrush="#44FFFFFF" CaretBrush="#F2F2F5"
                             ToolTip="Исполнитель, песня, альбом — Enter" KeyDown="MusicSearch_KeyDown"/>
                </DockPanel>

                <!-- сейчас играет во встроенном плеере -->
                <Border x:Name="MusicNowCard" Grid.Row="3" Style="{StaticResource Card}" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="MusicNowCover" Width="56" Height="56" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,56,56" RadiusX="9" RadiusY="9"/>
                            </Image.Clip>
                        </Image>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MusicNowTitle" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMain}"
                                       FontSize="14.5" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            <TextBlock x:Name="MusicNowArtist" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDim}"
                                       FontSize="12.5" FontFamily="{StaticResource UiFont}"/>
                            <Grid x:Name="MusicProgressArea" Height="10" Margin="0,6,0,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="MusicProgress_Click">
                                <Border Height="3" CornerRadius="1.5" Background="#33FFFFFF"/>
                                <Border x:Name="MusicProgressFill" Height="3" CornerRadius="1.5" Background="#F2F2F5"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RoundIcon}" Content="&#xE892;" ToolTip="Предыдущий" Click="MusicPrev_Click"/>
                            <Button x:Name="MusicPlayButton" Style="{StaticResource PlayButton}" Width="38" Height="38" Margin="4,0"
                                    Content="&#xE768;" Click="MusicPlay_Click"/>
                            <Button Style="{StaticResource RoundIcon}" Content="&#xE893;" ToolTip="Следующий" Click="MusicNext_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="4" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="MusicListTitle" Style="{StaticResource CapsLabel}" Margin="2,0,0,8"/>
                        <StackPanel x:Name="MusicList"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="MusicStatus" Grid.Row="5" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="2,6,0,0"/>
            </Grid>

            <!-- ===== ИИ-чаты: WebView2 создаются при первом открытии вкладки ===== -->
            <Grid x:Name="AiHost" Visibility="Collapsed" Margin="6,0,6,6"/>

            <!-- ===== Настройки: меню разделов слева, выбранный раздел справа ===== -->
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#0F0F13" BorderBrush="#22222A" BorderThickness="0,0,1,0">
                    <DockPanel Margin="8,10,8,10">
                        <Border DockPanel.Dock="Top" Background="#1A1A21" CornerRadius="9" Height="32" Margin="0,0,0,8">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#8C8C97" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SettingsSearchHint" Grid.Column="1" Text="Поиск настроек" FontSize="12" Foreground="#6F6F7A"
                                           FontFamily="{StaticResource UiFont}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="SettingsSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="12"
                                         Foreground="#F2F2F5" CaretBrush="#F2F2F5" VerticalAlignment="Center" Padding="0"
                                         TextChanged="SettingsSearch_Changed" KeyDown="SettingsSearch_KeyDown"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SettingsSearchEmpty" DockPanel.Dock="Top" Text="Ничего не найдено" Style="{StaticResource SetHint}"
                                   Margin="10,4,0,0" Visibility="Collapsed"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SettingsNavPanel">
                                <RadioButton x:Name="SetNav_general" Style="{StaticResource SetNav}" Tag="general" Checked="SettingsNav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource SetIcon}"/>
                                        <TextBlock Text="Основные"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SetNav_look" Style="{StaticResource SetNav}" Tag="look" Checked="SettingsNav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE790;" Style="{StaticResource SetIcon}"/>
                                        <TextBlock Text="Внешний вид"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SetNav_voice" Style="{StaticResource SetNav}" Tag="voice" Checked="SettingsNav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE720;" Style="{StaticResource SetIcon}"/>
                                        <TextBlock Text="Голосовой помощник"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SetNav_ai" Style="{StaticResource SetNav}" Tag="ai" Checked="SettingsNav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE99A;" Style="{StaticResource SetIcon}"/>
                                        <TextBlock Text="ИИ и быстрая строка"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SetNav_weather" Style="{StaticResource SetNav}" Tag="weather" Checked="SettingsNav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9CA;" Style="{StaticResource SetIcon}"/>
                                        <TextBlock Text="Погода"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SetNav_notify" Style="{StaticResource SetNav}" Tag="notify" Checked="SettingsNav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA8F;" Style="{StaticResource SetIcon}"/>
                                        <TextBlock Text="Уведомления"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SetNav_games" Style="{StaticResource SetNav}" Tag="games" Checked="SettingsNav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7FC;" Style="{StaticResource SetIcon}"/>
                                        <TextBlock Text="Игры и загрузки"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SetNav_focus" Style="{StaticResource SetNav}" Tag="focus" Checked="SettingsNav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE916;" Style="{StaticResource SetIcon}"/>
                                        <TextBlock Text="Фокус и Pomodoro"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SetNav_data" Style="{StaticResource SetNav}" Tag="data" Checked="SettingsNav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource SetIcon}"/>
                                        <TextBlock Text="Данные и журнал"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
