<Window x:Class="WikarIsland.Views.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WikarIsland.Controls"
        Title="Wikar Island"
        Width="460" Height="76"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual">
    <!-- Окно шире пилюли: пилюля меняет ширину по содержимому, прозрачные поля пропускают клики насквозь -->
    <Grid Margin="8,6">
        <Border x:Name="Pill"
                Height="34" MinWidth="150" CornerRadius="17"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="Transparent"
                RenderTransformOrigin="0.5,0"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
                MouseWheel="Pill_MouseWheel">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="PillGlow" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>

            <Grid>
            <!-- живая подложка: форма пилюли рисуется здесь -->
            <controls:LiquidPill x:Name="Liquid"/>
            <StackPanel Orientation="Horizontal" Margin="12,0" HorizontalAlignment="Center">
                <!-- «Не беспокоить» -->
                <TextBlock x:Name="DndIcon" Visibility="Collapsed" Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12.5" Foreground="#B9A6FF" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"
                           ToolTip="Не беспокоить — нажми, чтобы выключить" MouseLeftButtonDown="DndIcon_MouseLeftButtonDown"/>
                <!-- VPN: один клик — подключить / отключить -->
                <Border x:Name="VpnChip" Visibility="Collapsed" Background="#1EFFFFFF" CornerRadius="10" Padding="7,3"
                        Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonDown="VpnChip_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="VpnIcon" Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#8A8A94" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VpnText" Margin="5,0,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A8A94"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI" Text="VPN"/>
                    </StackPanel>
                </Border>
                <!-- zapret: один клик — включить / выключить обход -->
                <Border x:Name="ZapretChip" Visibility="Collapsed" Background="#1EFFFFFF" CornerRadius="10" Padding="7,3"
                        Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonDown="ZapretChip_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ZapretIcon" Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#8A8A94" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ZapretText" Margin="5,0,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A8A94"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI" Text="zapret"/>
                    </StackPanel>
                </Border>
                <Grid VerticalAlignment="Center">

                <!-- Обычное состояние: глаза, погода, часы -->
                <StackPanel x:Name="IdlePart" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid x:Name="DiscordBadge" Visibility="Collapsed" Margin="2,0,10,0" VerticalAlignment="Center"
                          ToolTip="Новые сообщения в Discord">
                        <Image x:Name="DiscordIcon" Width="18" Height="18"/>
                        <Border Background="#F23F43" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-8,0">
                            <TextBlock x:Name="DiscordCount" Text="1" Foreground="White" FontSize="9.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="TimerChip" Orientation="Horizontal" Visibility="Collapsed" Margin="2,0,10,0"
                                VerticalAlignment="Center" ToolTip="Таймер выключения">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#FF8A80" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TimerChipText" Margin="5,0,0,0" Foreground="#FFB4AD" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    </StackPanel>
                    <TextBlock x:Name="GameChip" Visibility="Collapsed" Margin="2,0,10,0" MaxWidth="150"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="#B8E0B0" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                    <controls:EyesControl x:Name="Eyes" VerticalAlignment="Center" Margin="2,0"/>
                    <StackPanel x:Name="PillWeather" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <controls:WeatherIcon x:Name="PillWeatherIcon" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PillWeatherText" Margin="4,0,0,0" VerticalAlignment="Center"
                                   Foreground="#D8D8E0" FontSize="13"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    </StackPanel>
                    <TextBlock x:Name="TimeText" Text="00:00" VerticalAlignment="Center" Margin="10,0,2,0"
                               Foreground="#F2F2F5" FontSize="14" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </StackPanel>

                <!-- Играет музыка -->
                <StackPanel x:Name="MusicPart" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="24" Height="24">
                        <Image x:Name="PillCover" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6"/>
                            </Image.Clip>
                        </Image>
                        <Image x:Name="PillAppIcon" Width="12" Height="12" Margin="0,0,-4,-4"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                    <TextBlock x:Name="PillTrack" MaxWidth="190" Margin="10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#F2F2F5" FontSize="13" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Segoe UI"/>
                    <controls:EqualizerControl x:Name="Eq" Margin="0,0,2,0"/>
                </StackPanel>

                <!-- Карточка уведомления -->
                <Grid x:Name="NotifyPart" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NotifyClose" Grid.Column="2" Content="&#xE711;" ToolTip="Закрыть уведомление"
                            Click="NotifyClose_Click" Cursor="Hand" Width="26" Height="26" VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#B8B8C2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="13" Background="#1FFFFFFF">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Image x:Name="NotifyIcon" Width="30" Height="30" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Width="300">
                        <TextBlock x:Name="NotifyTitle" TextTrimming="CharacterEllipsis"
                                   Foreground="#F2F2F5" FontSize="13.5" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"/>
                        <TextBlock x:Name="NotifyBody" TextTrimming="CharacterEllipsis"
                                   Foreground="#B8B8C2" FontSize="12.5"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"/>
                    </StackPanel>
                </Grid>

                <!-- Предупреждение таймера выключения -->
                <Grid x:Name="TimerPart" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                               Foreground="#FF6B61" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center" Width="300">
                        <TextBlock x:Name="TimerTitle" Foreground="#F2F2F5" FontSize="13.5" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"/>
                        <TextBlock Text="Нажми, чтобы отменить" Foreground="#B8B8C2" FontSize="12.5"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"/>
                    </StackPanel>
                </Grid>

                <!-- Идёт запись экрана -->
                <StackPanel x:Name="RecordPart" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTip="Идёт запись экрана — нажми, чтобы остановить">
                    <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#FF453A" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RecordLabel" Text="Запись" Margin="8,0,8,0" VerticalAlignment="Center"
                               Foreground="#F2F2F5" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                    <TextBlock x:Name="RecordTime" Text="0:00" VerticalAlignment="Center"
                               Foreground="#FFB4AD" FontSize="13" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    <TextBlock Text="&#xE71A;" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="#F2F2F5" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                </StackPanel>

                <!-- Загрузка в Steam -->
                <StackPanel x:Name="SteamPart" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image x:Name="SteamIcon" Width="18" Height="18" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SteamName" MaxWidth="160" Margin="9,0,10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#F2F2F5" FontSize="13" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Segoe UI"/>
                    <Grid Width="60" Height="5" VerticalAlignment="Center">
                        <Border Background="#33FFFFFF" CornerRadius="2.5"/>
                        <Border x:Name="SteamFill" Background="#66C0F4" CornerRadius="2.5" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock x:Name="SteamPercent" Margin="8,0,2,0" VerticalAlignment="Center"
                               Foreground="#F2F2F5" FontSize="12.5" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </StackPanel>

                <!-- Громкость (колёсико мыши над пилюлей) -->
                <StackPanel x:Name="VolumePart" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="VolumeIcon" Text="&#xE767;" VerticalAlignment="Center"
                               Foreground="#F2F2F5" FontSize="15"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    <Grid Width="90" Height="5" Margin="10,0" VerticalAlignment="Center">
                        <Border Background="#33FFFFFF" CornerRadius="2.5"/>
                        <Border x:Name="VolumeFill" Background="#F2F2F5" CornerRadius="2.5"
                                HorizontalAlignment="Left" Width="45"/>
                    </Grid>
                    <TextBlock x:Name="VolumeText" Text="50" Width="26" VerticalAlignment="Center"
                               Foreground="#F2F2F5" FontSize="13" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </StackPanel>
                </Grid>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
