<Window x:Class="WikarIsland.Views.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WikarIsland.Controls"
        Title="Wikar Island"
        Width="176" Height="46"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual">
    <Grid>
        <Border x:Name="Pill"
                Width="150" Height="34" CornerRadius="17"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FF0B0B0E" BorderBrush="#26FFFFFF" BorderThickness="1"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>

            <Grid Margin="14,0">
                <controls:EyesControl x:Name="Eyes" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="TimeText" Text="00:00"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#F2F2F5" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
            </Grid>
        </Border>
    </Grid>
</Window>
